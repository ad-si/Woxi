$CellContext`fMHz$$, $CellContext`\[Omega]tdeg$$}, ControlPlacement -> Left, 
        ContinuousAction -> False, AutorunSequencing -> {{4, 30}}, 
        SynchronousUpdating -> False}, 
      "DefaultOptions" :> {ControllerLinking -> True}],
     ImageSizeCache->{588.1228125, {234.90445861816409`, 240.63639221191409`}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>(($CellContext`\[Epsilon]o = 
       8.854187818 10^(-12); $CellContext`\[Mu]o = (4 Pi) 
        10^(-7); $CellContext`\[Eta] = 376.730313; $CellContext`c = 
       2.99792458 10^8; $CellContext`huef[
         Pattern[$CellContext`x, 
          Blank[]], 
         Pattern[$CellContext`opac, 
          Blank[]]] := {
         Hue[
          If[$CellContext`x > 1, 0., 
           If[$CellContext`x < 0, 0.75, 0.75 (1 - $CellContext`x)]]], 
         Opacity[$CellContext`opac]}; $CellContext`huelogf[
         Pattern[$CellContext`x, 
          Blank[]], 
         Pattern[$CellContext`xrange, 
          Blank[List]]] := Hue[
         If[$CellContext`x > Part[$CellContext`xrange, 2], 0., 
          If[$CellContext`x < Part[$CellContext`xrange, 1], 0.75, 
           0.75 (1 - Log[$CellContext`x/Part[$CellContext`xrange, 1]]/Log[
            Part[$CellContext`xrange, 2]/
             Part[$CellContext`xrange, 1]])]]]; $CellContext`logscale[
         Pattern[$CellContext`x, 
          Blank[]], 
         Pattern[$CellContext`xrange, 
          Blank[]]] := 
       If[Norm[$CellContext`x] > Part[$CellContext`xrange, 2], $CellContext`x/
         Norm[$CellContext`x], 
         If[
         Norm[$CellContext`x] < Part[$CellContext`xrange, 1], 
          0 $CellContext`x, (
           Log[Norm[$CellContext`x]/Part[$CellContext`xrange, 1]]/Log[
           Part[$CellContext`xrange, 2]/
            Part[$CellContext`xrange, 1]]) ($CellContext`x/
           Norm[$CellContext`x])]]); Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
