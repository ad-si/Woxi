Cell[CellGroupData[{

Cell[TextData[{
 "Details & Citations",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"DetailCells", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
         TextData[{
          "This optional section is for a more detailed description of the \
Demonstration than the caption, but it should still be as concise as \
possible. This section may also include numbered snapshot captions (e.g., \
Snapshot 1: phrase or sentence without an initial capital and without a \
period, unless more than one sentence is used) and explanations of the ", 
           StyleBox["Manipulate", "MRbig"], 
           " control labels. Define any symbols undefined so far. Include \
only text in this section \[LongDash] no code, graphics, etc. Do not change \
the cell style or copy cells from other sections. \n\nA book reference uses \
this format: \n   L. D. Schmidt, ", 
           StyleBox[
           "The Engineering of Chemical Reactions", FontSlant -> "Italic"], 
           ", New York: Oxford University Press, 1998. \n\nAn article \
reference uses this format: \n   D. Pearson, \"A Polynomial-Time Algorithm \
for the Change-Making Problem,\" ", 
           StyleBox["Operations Research Letters", FontSlant -> "Italic"], 
           ", ", 
           StyleBox["33", FontWeight -> "Bold"], 
           "(3), 2005 pp. 231\[Dash]234."}], "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoDetailCells"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "206694d3-6762-4efb-b1fc-9081531046f9"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "DetailCells"},
 DefaultNewCellStyle->"Text",
 CellTags->{
  "AuthorNotes", "DetailCells", "Details & Citations", "TemplateCellGroup"},
 CellID->441931514,ExpressionUUID->"899e4f8e-f933-4e98-864a-5fadd9a28e29"],

Cell[TextData[{
 "The antenna current is assumed to be a standing wave ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"I", "(", "z", ")"}], "=", " ", 
    RowBox[{
     SubscriptBox["I", "p"], " ", "sin", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"k", " ", "d"}], "2"], "-", "k"}], "|", "z", "|"}], 
      ")"}]}]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "d747d402-1a11-4576-9cda-667a86d6c112"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", 
    FractionBox["\[Omega]", "c"]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"53965613-9571-4cd9-a2ae-0bca9c3bdc68"],
 " is the propagation constant (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", 
    RowBox[{"2", " ", "\[DoubledPi]", " ", "f"}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"fca664bf-6b76-4c67-b29d-217c61bbba45"],
 " is the angular velocity and ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]], "InlineMath",ExpressionUUID->
  "e53658ec-6697-4359-baf8-2398df75eb95"],
 " is the speed of light). From the charge conservation law, the charge \
density per unit length is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", "z", ")"}], "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"sign", "(", "z", ")"}], "  ", 
       SubscriptBox["I", "p"]}], 
      RowBox[{"i", " ", "c"}]], " ", "cos", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"k", " ", "d"}], "2"], "-", "k"}], " ", "|", "z", "|"}], 
      ")"}]}]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "c8bf4a36-cc5b-41e7-a708-af9bddfff804"],
 ". These complex values represent harmonic quantities. The scalar and vector \
potentials are determined by"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{
  3.5904880882583504`*^9, {3.5904884866534505`*^9, 3.5904885304739275`*^9}, {
   3.590488574949606*^9, 3.5904886032792554`*^9}, 3.590488710607444*^9, {
   3.59048875366352*^9, 3.5904888012914033`*^9}, {3.590488982095721*^9, 
   3.590489080641094*^9}, {3.590489180465669*^9, 3.5904891818852715`*^9}, {
   3.59065416233939*^9, 3.5906541911140356`*^9}, {3.5906543000172644`*^9, 
   3.5906543043435116`*^9}, {3.590654358081586*^9, 3.5906543793368015`*^9}, {
   3.590654419343089*^9, 3.5906544767993755`*^9}, {3.5906546088339276`*^9, 
   3.59065465135036*^9}, 3.59065468510229*^9, 3.5906549900447316`*^9, {
   3.5906550298800097`*^9, 3.5906550999710193`*^9}, {3.590655151610973*^9, 
   3.5906551651547475`*^9}, {3.5906553141292686`*^9, 3.590655408256652*^9}, {
   3.5906554561313906`*^9, 3.5906554724323225`*^9}, {3.5906555770813084`*^9, 
   3.590655602367755*^9}, {3.590655941921176*^9, 3.5906561559124155`*^9}, {
   3.5906567839433365`*^9, 3.5906569130367203`*^9}, 3.590656946858655*^9, {
   3.5906970299473457`*^9, 3.590697119959504*^9}, 3.5907159937372985`*^9, {
   3.590716898800888*^9, 3.590716903387296*^9}, {3.5907169728542185`*^9, 
   3.590716984679039*^9}, {3.5907170743635964`*^9, 3.5907171061252527`*^9}, {
   3.5908937671859837`*^9, 3.59089379910364*^9}, {3.590931936187519*^9, 
   3.590932032367107*^9}, {3.59101790065874*^9, 3.591017901131153*^9}},
 CellID->647266419,ExpressionUUID->"30a9302f-285a-4f82-a47e-0a14ab27efb8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", "(", 
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{
       RowBox[{"-", "d"}], "/", "2"}], 
      RowBox[{"d", "/", "2"}]], 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"\[Rho]", "(", " ", 
         RowBox[{"z", "'"}], " ", 
         StyleBox[")",
          FontSlant->"Plain"]}], 
        StyleBox[
         StyleBox[
          RowBox[{
           StyleBox[" ",
            FontFamily->"Arial",
            FontSize->8,
            FontWeight->"Bold"], " "}]],
         FontSlant->"Italic"], 
        StyleBox[
         SuperscriptBox[
          StyleBox["e",
           FontSlant->"Italic"], 
          RowBox[{
           RowBox[{
            RowBox[{"-", "i"}], " ", "k"}], " ", "|", 
           StyleBox[" ",
            FontSlant->"Plain"], 
           RowBox[{
            StyleBox["r",
             FontWeight->"Bold",
             FontSlant->"Plain"], "'"}], " ", 
           StyleBox["|",
            FontSlant->"Plain"]}]],
         FontSlant->"Italic"], 
        StyleBox[" ",
         FontSlant->"Italic"]}], 
       RowBox[{
        RowBox[{"4", " ", "\[Pi]", " ", 
         SubscriptBox["\[Epsilon]", "0"]}], "  ", 
        StyleBox["|",
         FontSlant->"Italic"], 
        StyleBox["  ",
         FontSlant->"Italic"], 
        RowBox[{
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], 
         StyleBox["'",
          FontSlant->"Italic"]}], " ", 
        StyleBox["|",
         FontSlant->"Plain"], 
        StyleBox[" ",
         FontSlant->"Plain"]}]], "d", "\[InvisibleSpace]", 
      RowBox[{"z", "'"}]}]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"de30f14c-9f32-41d8-8cd2-1881d60dd88d"],
 ","
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.590932063556479*^9, 3.590932100575766*^9}},
 CellID->1753448876,ExpressionUUID->"9577dbae-135f-418f-8d01-e7479beb2417"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "(", 
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     StyleBox[" ",
      FontFamily->"Arial",
      FontSize->8,
      FontWeight->"Bold"], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"0", ",", " ", "0", ",", 
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{
         RowBox[{"-", "d"}], "/", "2"}], 
        RowBox[{"d", "/", "2"}]], 
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["\[Mu]", "0"], " ", 
          RowBox[{"I", "(", " ", 
           RowBox[{"z", "'"}], " ", 
           StyleBox[")",
            FontSlant->"Plain"]}], 
          StyleBox["  ",
           FontFamily->"Arial",
           FontSize->8,
           FontWeight->"Bold",
           FontSlant->"Italic"], 
          SuperscriptBox["e", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "i"}], " ", "k"}], "  ", 
            StyleBox["|",
             FontSlant->"Italic"], 
            StyleBox[
             RowBox[{
              StyleBox[" ",
               FontSlant->"Italic"], " "}]], 
            RowBox[{
             StyleBox["r",
              FontWeight->"Bold",
              FontSlant->"Plain"], "'"}], " ", 
            StyleBox["|",
             FontSlant->"Plain"], 
            StyleBox[" ",
             FontSlant->"Plain"]}]]}], 
         RowBox[{
          RowBox[{"4", " ", "\[Pi]"}], " ", 
          StyleBox["|",
           FontSlant->"Italic"], 
          StyleBox[" ",
           FontSlant->"Italic"], 
          RowBox[{
           StyleBox["r",
            FontWeight->"Bold",
            FontSlant->"Plain"], 
           StyleBox["'",
            FontSlant->"Italic"]}], " ", 
          StyleBox["|",
           FontSlant->"Plain"], 
          StyleBox[" ",
           FontSlant->"Plain"]}]], 
        RowBox[{"\[DifferentialD]", 
         SuperscriptBox["z", "'"]}]}]}]}], ")"}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"c458a1f4-f3b9-429e-8662-5883b31d5f3f"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.590932106902529*^9, 3.5909321563442793`*^9}},
 CellID->297171151,ExpressionUUID->"f40b026d-7645-4f1f-85cf-1899e9b647a0"],

Cell[TextData[{
 "Using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s symbolic calculation in vector analysis, it is possible to write down \
the mathematical equations for the electromagnetic fields ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Del]", " ", "\[Phi]"}]}], " ", "-", 
     RowBox[{"i", " ", "\[Omega]", " ", 
      StyleBox["A",
       FontWeight->"Bold",
       FontSlant->"Plain"]}]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"eedb51e8-b0b8-4cea-94e8-e078dbcaa082"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{
     FractionBox["1", 
      SubscriptBox["\[Mu]", "0"]], " ", 
     RowBox[{"\[Del]", 
      RowBox[{"\[Cross]", 
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"]}]}]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"dbc9a250-bfed-49ff-9220-2a7546d17b4a"],
 " in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", 
    RowBox[{"(", "z", ")"}]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "1bbc9a87-226e-4530-989f-ca64f7bdcceb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", "z", ")"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"92d6640f-7c78-4568-82c0-ae227bdc40e1"],
 " directly. The somewhat lengthy expressions in the program are derived by \
approximating the integrations with the summations over the whole length of \
antenna parts (the number of divisions is set to eight for the sake of \
simplicity). The instantaneous fields are calculated by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontWeight->"Bold",
      FontSlant->"Plain"], "(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
    RowBox[{"Re", "[", 
     RowBox[{
      StyleBox["E",
       FontWeight->"Bold",
       FontSlant->"Plain"], " ", 
      SuperscriptBox["e", 
       RowBox[{"i", " ", "\[Omega]", " ", "t"}]]}], "]"}]}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "9cea9db4-a5ce-40df-b7d2-96fc7a6893a2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["H",
      FontWeight->"Bold",
      FontSlant->"Plain"], "(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
    RowBox[{"Re", "[", 
     RowBox[{
      StyleBox["H",
       FontWeight->"Bold",
       FontSlant->"Plain"], " ", 
      SuperscriptBox["e", 
       RowBox[{"i", " ", "\[Omega]", " ", "t"}]]}], "]"}]}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "f7becb29-72d0-46c3-a932-72d0c6f629e9"],
 ". Correspondingly, the Poynting vector is calculated by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["S",
      FontWeight->"Bold",
      FontSlant->"Plain"], "(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", " ", "t"}], ")"}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["E",
       FontWeight->"Bold",
       FontSlant->"Plain"], "(", 
      RowBox[{
       StyleBox["r",
        FontWeight->"Bold",
        FontSlant->"Plain"], ",", " ", "t"}], ")"}], "\[Cross]", 
     RowBox[{
      StyleBox["H",
       FontWeight->"Bold",
       FontSlant->"Plain"], "(", 
      RowBox[{
       StyleBox["r",
        FontWeight->"Bold",
        FontSlant->"Plain"], ",", " ", "t"}], ")"}]}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"423846e3-6b82-45ae-a625-3b6917eb8880"],
 ", and the electromagnetic energy density by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"W", "(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["\[Epsilon]", "0"], " "}], "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"|", 
         RowBox[{
          StyleBox["E",
           FontWeight->"Bold",
           FontSlant->"Plain"], "(", 
          RowBox[{
           StyleBox["r",
            FontWeight->"Bold",
            FontSlant->"Plain"], ",", "t"}], ")"}], "|"}], ")"}], "2"]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["\[Mu]", "0"], " "}], "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"|", 
         RowBox[{
          StyleBox["H",
           FontWeight->"Bold",
           FontSlant->"Plain"], "(", 
          RowBox[{
           StyleBox["r",
            FontWeight->"Bold",
            FontSlant->"Plain"], ",", "t"}], ")"}], "|"}], ")"}], "2"]}]}]}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "82c44099-72eb-405b-a348-2a109f53be42"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{
