Cell[TextData[{
 "Denoting the wavelength ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "/", "f"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "09a1859c-9e76-4f3e-b2e2-18eb9c09c356"],
 " by ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "db853d23-4c30-47af-8b7e-059f689114a9"],
 ", snapshots 1, 2, and 3 are cases for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "/", "2"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"937a8bf5-08c3-4b71-ba58-20beb1e4d757"],
 ", ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "44993d1e-23db-483f-ab46-5b5bfa997708"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", " ", "\[Lambda]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"c559e4c2-e10c-4113-b03b-1c2961d1d8e3"],
 ", respectively. In the first two cases, the electromagnetic radiation is \
directed laterally, but in the relatively long antenna for snapshot 3, \
substantial radiation is produced near the axial directions."
}], "Text",
 TaggingRules->{},
