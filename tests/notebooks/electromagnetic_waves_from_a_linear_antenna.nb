Cell[TextData[{
 "This Demonstration shows the electromagnetic fields around a linear antenna \
excited by a sinusoidal standing wave. The antenna direction is taken as the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath",ExpressionUUID->
  "ddb19412-242e-4eca-87f0-229b66950541"],
 " axis. The electric and magnetic fields are displayed in the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath",ExpressionUUID->
  "484935f0-ffdb-4d2d-8ec2-927ff15b356d"],
 "-",
 Cell[BoxData[
  FormBox["y", TraditionalForm]], "InlineMath",ExpressionUUID->
  "5b4afb92-e9b4-49f1-bf64-b97313a9d0a2"],
 " and ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath",ExpressionUUID->
  "d95f0b03-5c28-4fad-8f63-9e6871aac4fb"],
 "-",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath",ExpressionUUID->
  "66e3f47b-54e1-445f-8c5f-28b9d17c1e00"],
 " planes together with Poynting vectors, shown by the arrows with length \
logarithmically scaled. The electromagnetic energy density is shown by color. \
You can vary the antenna length ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineMath",ExpressionUUID->
  "52687c45-a3f8-42d8-b68b-b3935b8eb7a0"],
 ", current ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "p"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "012f4c1a-0904-4fd2-81b2-fef7e39ea022"],
 ", and frequency ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]], "InlineMath",ExpressionUUID->
  "d3f5baab-07d9-46b0-84bc-012d08ed56ac"],
 ", as well as the observation instant or phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", " ", "t"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"cfa31b64-7c86-4676-9be5-dce4e21ced44"],
 ". It is possible to see the animation by changing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", " ", "t"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"46474514-d94b-4532-be61-659afc6b9709"],
 " automatically, although you have to reduce the speed to a very low level."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{
  3.5904880882583504`*^9, {3.5904884866534505`*^9, 3.5904885304739275`*^9}, {
