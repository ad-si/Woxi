Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "f", ",", " ", "\[Omega]", ",", " ", "k", ",", " ", "\[Omega]t", ",", 
       " ", "Ev", ",", " ", "Hv", ",", " ", "S", ",", " ", "W", ",", "zv", 
       ",", " ", "Iv", ",", "\[Rho]v", ",", " ", 
       RowBox[{"Erange", "=", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["10", "0"], ",", " ", 
          SuperscriptBox["10", "3"]}], "}"}]}], ",", " ", 
       RowBox[{"Wrange", "=", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["10", 
           RowBox[{"-", "10"}]], ",", " ", 
          SuperscriptBox["10", 
           RowBox[{"-", "4"}]]}], "}"}]}], ",", " ", 
       RowBox[{"Srange", "=", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["10", 
           RowBox[{"-", "4"}]], ",", " ", 
          SuperscriptBox["10", "2"]}], "}"}]}], ",", " ", 
       RowBox[{"\[CapitalDelta]", "=", "0.15"}], ",", " ", "g0", ",", " ", 
       "g1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "=", 
       RowBox[{"fMHz", "*", 
        SuperscriptBox["10", "6"]}]}], ";", " ", 
      RowBox[{"\[Omega]", "=", 
       RowBox[{"2", " ", "\[Pi]", " ", "f"}]}], ";", " ", 
      RowBox[{"k", "=", 
       FractionBox["\[Omega]", "c"]}], ";", " ", 
      RowBox[{"\[Omega]t", "=", 
       RowBox[{"\[Omega]tdeg", " ", "Degree"}]}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"zv", "=", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "#"}], "-", "9"}], ")"}], " ", "d"}], "16"], "&"}], 
        "/@", 
        RowBox[{"Range", "[", "8", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Rho]v", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"Sign", "[", "zv", "]"}], " ", "Ip"}], 
         RowBox[{"\[ImaginaryI]", " ", "c"}]], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"k", " ", "d"}], "2"], "-", " ", 
          RowBox[{"k", " ", 
           RowBox[{"Abs", "[", "zv", "]"}]}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Iv", "=", 
       RowBox[{"Ip", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"k", " ", "d"}], "2"], "-", " ", 
          RowBox[{"k", " ", 
           RowBox[{"Abs", "[", "zv", "]"}]}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Ev", "[", 
        RowBox[{
        "x_", ",", " ", "y_", ",", " ", "z_", ",", " ", "\[Omega]t_"}], "]"}],
        ":=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Fv", "=", 
           FractionBox[
            RowBox[{
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox["x", "2"], "+", 
                 SuperscriptBox["y", "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"z", "-", "zv"}], ")"}], "2"]}]]}]], " "}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"], "+", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"z", "-", "zv"}], ")"}], "2"]}], ")"}], 
             RowBox[{"3", "/", "2"}]]]}], "}"}], ",", " ", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              FractionBox["d", 
               RowBox[{"32", " ", "\[Pi]", " ", "\[Epsilon]o"}]], " ", 
              RowBox[{"\[Rho]v", ".", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "+", 
                    FractionBox[
                    RowBox[{"\[ImaginaryI]", " ", "k", " ", "x"}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"z", "-", 
                    RowBox[{
                    "zv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}], "2"]}], ")"}], 
                    RowBox[{"1", "/", "2"}]]]}], ",", 
                    RowBox[{"y", "+", 
                    FractionBox[
                    RowBox[{"\[ImaginaryI]", " ", "k", " ", "y"}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"z", "-", 
                    RowBox[{
                    "zv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}], "2"]}], ")"}], 
                    RowBox[{"1", "/", "2"}]]]}], ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"z", "-", 
                    RowBox[{
                    "zv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}], "+", 
                    FractionBox[
                    RowBox[{"\[ImaginaryI]", " ", "k", " ", 
                    RowBox[{"(", 
                    RowBox[{"z", "-", 
                    RowBox[{
                    "zv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}]}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"z", "-", 
                    RowBox[{
                    "zv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}], "2"]}], ")"}], 
                    RowBox[{"1", "/", "2"}]]]}]}], " ", "}"}], 
                    RowBox[{
                    "Fv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}], "&"}], "/@", 
                 RowBox[{"Range", "[", "8", "]"}]}], ")"}]}]}], "-", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", 
               RowBox[{
                FractionBox[
                 RowBox[{" ", 
                  RowBox[{
                  "\[Mu]o", " ", "d", " ", "\[ImaginaryI]", " ", 
                   "\[Omega]"}]}], 
                 RowBox[{"32", " ", "\[Pi]"}]], " ", 
                RowBox[{"Iv", ".", 
                 RowBox[{"(", 
                  FractionBox[
                   SuperscriptBox["\[ExponentialE]", 
                    RowBox[{
                    RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"z", "-", "zv"}], ")"}], "2"]}]]}]], 
                   SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"z", "-", "zv"}], ")"}], "2"]}]]], ")"}]}]}]}], 
              "}"}]}], ")"}], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[ImaginaryI]", " ", "\[Omega]t"}]]}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Hv", "[", 
        RowBox[{
        "x_", ",", " ", "y_", ",", " ", "z_", ",", " ", "\[Omega]t_"}], "]"}],
        ":=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Fv", "=", 
           FractionBox[
            RowBox[{
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox["x", "2"], "+", 
                 SuperscriptBox["y", "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"z", "-", "zv"}], ")"}], "2"]}]]}]], " "}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"], "+", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"z", "-", "zv"}], ")"}], "2"]}], ")"}], 
             RowBox[{"3", "/", "2"}]]]}], "}"}], ",", " ", 
         RowBox[{"Re", "[", 
          RowBox[{
           FractionBox["d", 
            RowBox[{"32", " ", "\[Pi]"}]], " ", 
           RowBox[{"Iv", ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "y"}], "-", 
                    FractionBox[
                    RowBox[{"\[ImaginaryI]", " ", "k", " ", "y"}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"z", "-", 
                    RowBox[{
                    "zv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}], "2"]}], ")"}], 
                    RowBox[{"1", "/", "2"}]]]}], ",", 
                   RowBox[{"x", "+", 
                    FractionBox[
                    RowBox[{"\[ImaginaryI]", " ", "k", " ", "x"}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"z", "-", 
                    RowBox[{
                    "zv", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], ")"}], "2"]}], ")"}], 
                    RowBox[{"1", "/", "2"}]]]}], ",", "0"}], " ", "}"}], " ", 
                 
                 RowBox[{
                 "Fv", "\[LeftDoubleBracket]", "#", 
                  "\[RightDoubleBracket]"}]}], ")"}], "&"}], "/@", 
              RowBox[{"Range", "[", "8", "]"}]}], ")"}]}], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[ImaginaryI]", " ", "\[Omega]t"}]]}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"W", "[", 
        RowBox[{
        "x_", ",", " ", "y_", ",", " ", "z_", ",", " ", "\[Omega]t_"}], "]"}],
        ":=", 
       RowBox[{
        RowBox[{
         FractionBox["\[Epsilon]o", "2"], " ", 
         RowBox[{
          RowBox[{"Ev", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "\[Omega]t"}],
            "]"}], ".", 
          RowBox[{"Ev", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "\[Omega]t"}],
            "]"}]}]}], "+", 
        RowBox[{
         FractionBox["\[Mu]o", "2"], " ", 
         RowBox[{
          RowBox[{"Hv", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "\[Omega]t"}],
            "]"}], ".", 
          RowBox[{"Hv", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "\[Omega]t"}],
            "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
