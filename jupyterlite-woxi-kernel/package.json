{
  "name": "@woxi/jupyterlite-woxi-kernel",
  "version": "0.3.0",
  "description": "Woxi (Wolfram Language) kernel for JupyterLite",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlite",
    "jupyterlite-extension",
    "wolfram"
  ],
  "license": "MIT",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:lib": "tsc",
    "build:labextension": "jupyter-builder build .",
    "build:prod": "npm run build:lib && npm run build:labextension",
    "clean": "rimraf lib tsconfig.tsbuildinfo jupyterlite_woxi_kernel/labextension"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.4",
    "@jupyterlab/services": "^7.6.4",
    "@jupyterlite/services": "^0.8.6"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.3",
    "@jupyterlab/coreutils": "^6.6.4",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlite_woxi_kernel/labextension",
    "sharedPackages": {
      "@jupyterlite/services": {
        "bundled": false,
        "singleton": true
      }
    }
  }
}
