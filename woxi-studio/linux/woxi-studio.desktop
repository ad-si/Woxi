[Desktop Entry]
Type=Application
Name=Woxi Studio
Comment=Notebook editor for Wolfram Language .nb files
Exec=woxi-studio %f
Icon=woxi-studio
Terminal=false
Categories=Development;Education;Science;Math;
MimeType=application/vnd.wolfram.nb;application/mathematica;
Keywords=Wolfram;Mathematica;Notebook;CAS;
StartupWMClass=woxi-studio
